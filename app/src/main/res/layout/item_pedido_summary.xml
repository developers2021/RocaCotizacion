<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Pedido ID -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tvPedidoIdLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Pedido ID:"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvPedidoId"
                app:layout_constraintHorizontal_bias="0" />

            <TextView
                android:id="@+id/tvPedidoId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="12345"
                android:textSize="16sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toEndOf="@id/tvPedidoIdLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvPedidoIdLabel"
                app:layout_constraintBottom_toBottomOf="@id/tvPedidoIdLabel"
                app:layout_constraintHorizontal_bias="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginVertical="8dp"/>

        <!-- Tipo de Pago -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tvTipopagoLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Tipo de pago:"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvTipopago"
                app:layout_constraintHorizontal_bias="0" />

            <TextView
                android:id="@+id/tvTipopago"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Efectivo"
                android:textSize="16sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toEndOf="@id/tvTipopagoLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvTipopagoLabel"
                app:layout_constraintBottom_toBottomOf="@id/tvTipopagoLabel"
                app:layout_constraintHorizontal_bias="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginVertical="8dp"/>

        <!-- Total -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tvTotalLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Total:"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvTotal"
                app:layout_constraintHorizontal_bias="0" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="L. 150.00"
                android:textSize="16sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toEndOf="@id/tvTotalLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvTotalLabel"
                app:layout_constraintBottom_toBottomOf="@id/tvTotalLabel"
                app:layout_constraintHorizontal_bias="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginVertical="8dp"/>

        <!-- Sincronizado -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tvSincLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Sincronizado:"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvSinc"
                app:layout_constraintHorizontal_bias="0" />

            <TextView
                android:id="@+id/tvSinc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Sí"
                android:textSize="16sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toEndOf="@id/tvSincLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvSincLabel"
                app:layout_constraintBottom_toBottomOf="@id/tvSincLabel"
                app:layout_constraintHorizontal_bias="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginVertical="8dp"/>

        <!-- Código Cliente -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tvCodigoclienteLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Código Cliente:"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvCodigocliente"
                app:layout_constraintHorizontal_bias="0" />

            <TextView
                android:id="@+id/tvCodigocliente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="C-67890"
                android:textSize="16sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toEndOf="@id/tvCodigoclienteLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvCodigoclienteLabel"
                app:layout_constraintBottom_toBottomOf="@id/tvCodigoclienteLabel"
                app:layout_constraintHorizontal_bias="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
