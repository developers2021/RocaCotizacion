<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.Facturacion.FacturacionFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_facturacion"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:title=""
        tools:layout_editor_absoluteX="0dp" />

    <View
        android:id="@+id/green_line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
    android:background="#4CAF50"
    app:layout_constraintTop_toBottomOf="@id/toolbar_facturacion" />

    <!-- TabLayout for the bottom tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs_facturacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:tabMode="fixed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:tabGravity="fill" />

    <!-- ViewPager2 for the tab content -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager_facturacion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/green_line"
        app:layout_constraintBottom_toTopOf="@id/tabs_facturacion" />

</androidx.constraintlayout.widget.ConstraintLayout>
